local.file_match "shopsense_logs" {
  path_targets = [
    {
      __path__ = "/shopsense/*.log",
    },
  ]

  sync_period = "10s"
}

loki.source.file "shopsense_logs" {
  targets = local.file_match.shopsense_logs.targets

  forward_to = [loki.process.shopsense_logs.receiver]

  tail_from_end = true
}

loki.process "shopsense_logs" {
  stage.static_labels {
    values = {
      application = "shopsense",
      environment = "local",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}