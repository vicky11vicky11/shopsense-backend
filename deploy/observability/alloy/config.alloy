logging {
    level  = "info"
    format = "logfmt"
}

discovery.docker "shopsense" {
    host = "unix:///var/run/docker.sock"
}

discovery.relabel "shopsense_logs" {
    targets = discovery.docker.shopsense.targets

    rule {
        source_labels = ["__meta_docker_container_name"]
        regex         = "/(.*)"
        target_label  = "service"
    }
}

loki.source.docker "shopsense" {
    host          = "unix:///var/run/docker.sock"
    targets       = discovery.docker.shopsense.targets
    relabel_rules = discovery.relabel.shopsense_logs.rules
    labels = {
        environment = "docker",
    }
    forward_to = [loki.write.shopsense.receiver]
}

loki.write "shopsense" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}